# Copia este archivo a .env y ajusta los valores
# NO commitees el .env real (contiene secrets)

# Base de datos MySQL (docker-compose usa estos por defecto)
DB_USER=scanner_user
DB_PASS=admin123
DB_HOST=db
DB_NAME=scanner_db

# MySQL root password (para el contenedor db)
MYSQL_ROOT_PASSWORD=rootpass123

# Flask secret key (genera uno nuevo en prod: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia_esto_en_produccion_por_una_clave_larga_y_aleatoria

# Entorno
FLASK_ENV=production

# Opcional: habilitar agente local para escaneos de red
# AGENTE_HABILITADO=1
# AGENTE_TOKEN=tu_token_seguro_aqui