# Copia este archivo a .env y ajusta los valores
# NO commitees el .env real (contiene secrets)

# Base de datos MySQL (docker-compose usa estos por defecto)
DB_USER=scanner_user
DB_PASS=admin123
DB_HOST=db
DB_NAME=scanner_db

# MySQL root password (para el contenedor db)
MYSQL_ROOT_PASSWORD=rootpass123

# Flask secret key (genera uno nuevo en prod: python -c "import secrets; print(secrets.token_hex(32))")
# OBLIGATORIA en produccion: sin ella las sesiones se invalidan al reiniciar.
SECRET_KEY=cambia_esto_en_produccion_por_una_clave_larga_y_aleatoria

# Entorno
FLASK_ENV=production

# Cookies de sesion (True solo si el sitio va por HTTPS)
SESSION_COOKIE_SECURE=False
# Forzar redireccion a HTTPS (requiere HTTPS real)
FORCE_HTTPS=0

# Agente local de escaneo de red (ver README).
# El token es OBLIGATORIO si habilitas el agente: generado con
# python -c "import secrets; print(secrets.token_hex(24))"
# (admite varios tokens separados por coma)
# AGENTE_HABILITADO=1
# AGENTE_TOKEN=tu_token_seguro_aqui

# Escaneos en segundo plano (1): la API responde con el id del trabajo y el
# frontend muestra el progreso. Poner en 0 para ejecutar y esperar la respuesta.
ESCANEO_EN_SEGUNDO_PLANO=1

# Permitir analizar URLs privadas/locales (0 recomendado: evita SSRF)
PERMITIR_URLS_PRIVADAS=0

# Email (verificacion en dos pasos y recuperacion de contrasena).
# Gmail: activa la verificacion en 2 pasos de tu cuenta y genera una
# "Contrasena de aplicacion" en https://myaccount.google.com/apppasswords
# Sin configurar: en desarrollo los codigos/enlaces se registran en el log.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx
# SMTP_FROM=tu_correo@gmail.com
# TFA_CODIGO_MINUTOS=10
# TFA_MAX_INTENTOS=5
# RESET_TOKEN_MINUTOS=30
# RESET_MAX_INTENTOS=5
