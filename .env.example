# Copia este archivo a .env y ajusta los valores
# NO commitees el .env real (contiene secrets)

# Base de datos MySQL (docker-compose usa estos por defecto)
DB_USER=scanner_user
DB_PASS=admin123
DB_HOST=db
DB_NAME=scanner_db

# MySQL root password (para el contenedor db)
MYSQL_ROOT_PASSWORD=rootpass123

# Flask secret key (genera uno nuevo en prod: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia_esto_en_produccion_por_una_clave_larga_y_aleatoria

# Entorno
FLASK_ENV=production

# Opcional: habilitar agente local para escaneos de red
# AGENTE_HABILITADO=1
# AGENTE_TOKEN=tu_token_seguro_aqui

# Email 2FA (verificacion en dos pasos por correo, gratis con Gmail).
# 1. Activa la verificacion en 2 pasos de tu cuenta Google.
# 2. Genera una "Contrasena de aplicacion" en https://myaccount.google.com/apppasswords
# 3. Usa esa contrasena (16 letras) como SMTP_PASS, NO tu contrasena normal.
# Sin estas variables, el codigo 2FA se muestra en el log (modo desarrollo).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx
# SMTP_FROM=tu_correo@gmail.com
# TFA_CODIGO_MINUTOS=10
# TFA_MAX_INTENTOS=5